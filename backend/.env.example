# SmartLearn Backend Configuration

# Database Configuration (PostgreSQL / SQLite)
# Example for PostgreSQL: postgresql://postgres:password@localhost:5432/smartlearn
DATABASE_URL=sqlite:///./smartlearn.db

# Security & JWT Token
SECRET_KEY=smartlearn-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration ("mock" | "gemini" | "openrouter")
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Uploads & File Processing
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=uploads
